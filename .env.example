# All optional. Defaults shown.
# If DATABASE_URL is set, `npm start` skips Docker and uses this database.
# DATABASE_URL=...
PORT=3001

# ---- Accounts (Supabase Auth) ----
# Leave unset to run guest-only: everything still works, games just aren't tied to an account.
# Both values are public (they ship to the browser). Find them in the Supabase dashboard:
# Project Settings → API. The API reads VITE_SUPABASE_URL too, so these two lines configure both.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# Only for projects still using the legacy shared JWT secret (new projects use JWKS; leave unset):
# SUPABASE_JWT_SECRET=...

# ---- AI coach (Claude) ----
# Leave unset to run without it: Game Review keeps its template coach. Server-side only.
# ANTHROPIC_API_KEY=sk-ant-...
# COACH_MODEL=claude-haiku-4-5

# ---- Deployment only (leave unset locally) ----
# Web app → API origin when they're on different domains (read at build time by Vite).
# VITE_API_URL=https://api.example.com
# API: web-app origins allowed to call it cross-origin, comma-separated.
# WEB_ORIGIN=https://your-app.vercel.app
# API: CA certificate for TLS to hosted Postgres, as PEM (\n escapes allowed) or a file path.
# Supabase: Dashboard → Database settings → SSL Configuration → Download certificate.
# DATABASE_CA_CERT=/path/to/prod-ca-2021.crt
# Supabase DATABASE_URL: use the Session pooler string (port 5432), not the Transaction pooler.
